# Safe local defaults. Copy to .env and replace every production secret.
MERCH_APP_ENV=local
MERCH_PROVIDER_MODE=fake
MERCH_PUBLISH_MODE=dry_run
MERCH_MANUAL_APPROVAL_ENABLED=false
MERCH_ETSY_PRODUCTION_PARTNER_CHECK_ENABLED=false
MERCH_IP_CHECK_ENABLED=false
MERCH_PUBLIC_BASE_URL=http://localhost:8000
MERCH_SCHEDULE_TIMEZONE=America/New_York
MERCH_WORKFLOW_HOUR=9
MERCH_ANALYTICS_HOUR=9
MERCH_SCHEDULE_MINUTE=30
MERCH_SESSION_SECRET=replace-with-at-least-32-random-characters
MERCH_LOCAL_ADMIN_PASSWORD=merch-dev
# Create with: uv run merch hash-password
MERCH_ADMIN_PASSWORD_HASH=
MERCH_CREDENTIAL_ENCRYPTION_KEY=

MERCH_OPENAI_API_KEY=
MERCH_OPENAI_TEXT_MODEL=gpt-6-astra
MERCH_OPENAI_RESEARCH_MODEL=gpt-5.6-terra
MERCH_OPENAI_LISTING_MODEL=gpt-5.6-terra
MERCH_OPENAI_TYPOGRAPHY_MODEL=gpt-5.6-terra
MERCH_OPENAI_REASONING_EFFORT=medium
MERCH_OPENAI_CREATIVE_REASONING_EFFORT=high
MERCH_OPENAI_VISUAL_QA_DETAIL=high
MERCH_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
MERCH_OPENAI_IMAGE_QUALITY=medium
MERCH_OPENAI_IMAGE_REVISION_QUALITY=high
MERCH_FLAT_ARTWORK_CLEANUP_ENABLED=false
# Optional global font override: set both to a matching, installed custom face.
# Leave unset to select Noto Sans/Serif/Serif Display/Mono or Roboto Slab per design.
# MERCH_FONT_FAMILY=My Custom Font
# MERCH_FONT_FILE=/path/to/custom-font.ttf
MERCH_MAX_BRIEF_REWRITES=8
MERCH_ETSY_NATIVE_PUBLISH_GRACE_SECONDS=600

MERCH_PRINTIFY_API_TOKEN=
MERCH_PRINTIFY_WEBHOOK_SECRET=
MERCH_PRINTIFY_SHOP_SHOPIFY=
MERCH_PRINTIFY_SHOP_ETSY=
MERCH_PRINTIFY_SHOP_AMAZON_US=

MERCH_SHOPIFY_SHOP_DOMAIN=
MERCH_SHOPIFY_ADMIN_TOKEN=
MERCH_ETSY_API_KEY=
MERCH_ETSY_SHARED_SECRET=
# Live Etsy publication verification needs listings_r/listings_w OAuth access and a shop ID.
# Add a refresh token for unattended runs; it is rotated into encrypted connector storage.
MERCH_ETSY_ACCESS_TOKEN=
MERCH_ETSY_REFRESH_TOKEN=
MERCH_ETSY_SHOP_ID=
MERCH_AMAZON_LWA_CLIENT_ID=
MERCH_AMAZON_LWA_CLIENT_SECRET=
MERCH_AMAZON_REFRESH_TOKEN=

# Optional NVIDIA profile: docker compose --profile nvidia up --build
MERCH_REALESRGAN_ENDPOINT=

# Set only with: docker compose --profile observability up --build
MERCH_OTEL_EXPORTER_ENDPOINT=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
GRAFANA_ADMIN_PASSWORD=admin
